# Example environment variables
# Toggle Cloudflare adapter (Phase 1). Leave false until shadow read phase.
CF_ADAPTER_ENABLE=false
# Enable parallel shadow reads (Phase 2) – reads Netlify + Cloudflare (if bindings) and compares.
CF_SHADOW_READ_ENABLE=false
# Optional explicit Netlify site/token (rarely needed locally)
# BLOB_SITE_ID=
# BLOB_PAT=
# BLOBS_TOKEN=
# STATS_STORE=app-stats
# SHARE_STORE=shares

# --- Migration Script (Netlify -> Cloudflare) ---
# Netlify API access (blobs)
# NETLIFY_SITE_ID=
# NETLIFY_TOKEN=
# Cloudflare credentials
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# KV namespace IDs (from wrangler kv:namespace create)
# CF_KV_SHARES_NAMESPACE_ID=
# CF_KV_STATS_NAMESPACE_ID=
# Optional: sample size for verification (default 20)
# MIGRATION_VERIFY_SAMPLE=30

# --- Local Indexer ---
# EVM RPC endpoint used locally (HTTP)
RPC_URL=
# Chain ID and World address (lowercase)
CHAIN_ID=695569
WORLD_ADDRESS=0x0000000000000000000000000000000000000000
# Local SQLite DB path (will be created)
# [DEPRECATED] Local SQLite indexer variables (see docs/DEPRECATIONS.md)
LOCAL_DB_PATH=./data/local-indexer.db
# Ingestion ranges and tuning
FROM_BLOCK=0
TO_BLOCK=
CONFIRM_DEPTH=8
WINDOW_BLOCKS=20000
SEGMENT_BLOCKS=1200
# Optional allowlists (comma-separated lowercase)
ADDRESS_ALLOWLIST=
TOPIC0_ALLOWLIST=
