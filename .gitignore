node_modules/

# YoYo AI version control directory
.yoyo/

# Local Netlify folder
.netlify

# Temporary / credential artifacts (should not be committed)
temp_pat.txt
temp_site_id.txt
tmp_cf_*.txt

# Scratch workspace (ignored)
scratch/

# Cloudflare Wrangler local state (miniflare, etc.)
.wrangler/

# Temporary files and logs
tmp_*
*.tmp
*.log
*.bak

# Ad-hoc corruption markers created by external tools
True.corrupt.*

# Ad-hoc JSON/TXT snapshots
*.json.tmp
tmp_*.json
tmp_*.txt
eve-frontier-map/tmp_*.json

# Accidental nested copy
eve-frontier-map/eve-frontier-map/

# Local indexer artifacts
data/
!data/.gitkeep
eve-frontier-map/public/data/index-latest/*.json

# Python virtual environments & caches (prevent massive untracked file sets)
**/.venv*/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# dlt runtime artifacts (generated load packages & exported schemas)
**/.dlt/*/load_packages/**
**/.dlt/schemas/export/**

# Local DuckDB files created by smoke tests
**/*.duckdb

# Cloudflare exporter local env (contains secrets; do not commit)
tools/worldapi-cron/.env*
