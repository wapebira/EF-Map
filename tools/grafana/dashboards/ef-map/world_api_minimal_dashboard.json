{
  "__inputs": [
    {
      "name": "DS_WORLDAPI_PG",
      "label": "World API Postgres",
      "description": "Select the Postgres datasource connected to the EF indexer",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "1.0.0" },
    { "type": "panel", "id": "table", "name": "Table", "version": "1.0.0" }
  ],
  "title": "World API (Minimal) – Killmails, Types, Tribes, Smartcharacters",
  "timezone": "browser",
  "version": 1,
  "panels": [
    {
      "type": "table",
      "title": "World API ingest health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" },
          "rawSql": "SELECT schema, table_name, COALESCE(rows,0) AS rows, last_ingest_at, ROUND(minutes_since_ingest::numeric,2) AS minutes_since_ingest, pipeline_name, expected_cadence_min, last_heartbeat, ROUND(minutes_since_heartbeat::numeric,2) AS minutes_since_heartbeat, job_ok FROM world_api_dlt.worldapi_ingest_health ORDER BY table_name",
          "format": "table"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Killmails – count",
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT COUNT(*) FROM world_api_dlt.killmails", "format": "table" }
      ]
    },
    {
      "type": "stat",
      "title": "Smartcharacters – count",
      "gridPos": { "x": 6, "y": 9, "w": 6, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT COUNT(*) FROM world_api_dlt.smartcharacter", "format": "table" }
      ]
    },
    {
      "type": "stat",
      "title": "Tribes – count",
      "gridPos": { "x": 12, "y": 9, "w": 6, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT COUNT(*) FROM world_api_dlt.tribe", "format": "table" }
      ]
    },
    {
      "type": "stat",
      "title": "Types – count",
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT COUNT(*) FROM world_api_dlt.type", "format": "table" }
      ]
    },
    {
      "type": "stat",
      "title": "Last load (world_api_dlt)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT MAX(inserted_at) as last_load FROM world_api_dlt._dlt_loads", "format": "table" }
      ]
    },
    {
      "type": "stat",
      "title": "Heartbeat (minutes since)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 5 },
      "targets": [
        { "datasource": { "type": "postgres", "uid": "${DS_WORLDAPI_PG}" }, "rawSql": "SELECT EXTRACT(EPOCH FROM (NOW() - MAX(finished_at))) / 60 as minutes_since FROM world_api_dlt.ingest_heartbeat", "format": "table" }
      ]
    }
  ]
}
