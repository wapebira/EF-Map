{
  "name": "ef-map-archiver",
  "main": "archiver_worker.js",
  "compatibility_date": "2025-09-07",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "INDEX_DB", "database_name": "ef_index", "database_id": "cfc8fecb-9fe1-4ad0-98ed-525772d13ff0" },
  { "binding": "INDEX_DB_A1", "database_name": "ef_index_archive_1", "database_id": "d06e2eef-a125-4d9d-9d27-4116ef87d42e" },
  { "binding": "INDEX_DB_A2", "database_name": "ef_index_archive_2", "database_id": "90eafa41-e455-43e0-8cad-85e26a42f80d" }
  ],
  "vars": {
  "ARCHIVE_CUT_TO": "0",
  "ARCHIVE_CUT_DYNAMIC": "1",
  "ARCHIVE_CUT_OFFSET_BLOCKS": "30000",
  "ARCHIVE_PAGE_LIMIT": "1000",
  "ARCHIVE_RANGE_WINDOW": "4000",
  "ARCHIVE_MAX_PAGES": "12",
  "ARCHIVE_PAUSE_MS": "100",
  "ARCHIVE_A1_MAX_ROWS": "9500000"
  }
}
