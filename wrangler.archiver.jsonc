{
  "name": "ef-map-archiver",
  "main": "archiver_worker.js",
  "compatibility_date": "2025-09-07",
  // Disable cron schedule; manual ticks only via /admin/archive-tick
  "triggers": { "crons": [] },
  // D1 databases intentionally unbound (all three deleted to control costs). Archiver endpoints
  // will return binding-missing errors as expected until re-provisioned.
  "vars": {
  "ARCHIVE_CUT_TO": "0",
  "ARCHIVE_CUT_DYNAMIC": "1",
  "ARCHIVE_CUT_OFFSET_BLOCKS": "30000",
  "ARCHIVE_PAGE_LIMIT": "1000",
  "ARCHIVE_RANGE_WINDOW": "4000",
  "ARCHIVE_MAX_PAGES": "20",
  "ARCHIVE_PAUSE_MS": "50",
  "ARCHIVE_A1_MAX_ROWS": "9100000"
  }
}
